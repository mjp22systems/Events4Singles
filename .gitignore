# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite / DB files — data lives in Cloudflare D1, not in git
*.db
*.db-shm
*.db-wal

# Temp/QA dirs
/homepage-qa/
/backups/
/scripts/
/playwright-report/
/test-results/

# D1 migration SQL files — contain business data, generated locally
/tools/data-d1.sql
/tools/schema-d1.sql

# Wrangler build output (CF Pages)
/.wrangler/

.open-next/
/.open-next-stale-*/

# Local build/deploy logs and superseded stylesheet snapshots
/opennext-build.log
/public/portal-*.css
